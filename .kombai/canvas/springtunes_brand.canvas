      "html": "\n<div class=\"min-h-screen bg-[#FFFFFF] text-[#111827] font-['Inter'] selection:bg-[#22C55E]/30 overflow-x-clip\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=Inter:wght@400;500;600&display=swap');\n\n        /* Custom scrollbar for better aesthetics */\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #f1f1f1;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #22C55E;\n            border-radius: 10px;\n        }\n        \n        .logo-svg path {\n            vector-effect: non-scaling-stroke;\n        }\n    </style>\n\n    \n    <nav class=\"fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-[#111827]/5\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"3\">\n            <div class=\"flex items-center gap-3\" data-kid=\"4\">\n                <div class=\"w-10 h-10 rounded-full bg-[#22C55E] flex items-center justify-center p-2 group cursor-pointer overflow-hidden\" data-kid=\"5\">\n                    <svg viewBox=\"0 0 100 100\" class=\"w-full h-full header-logo\" data-kid=\"6\">\n                        <path d=\"M35 65 V45\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"7\"></path>\n                        <path d=\"M50 75 V25\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"8\"></path>\n                        <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"9\"></path>\n                    </svg>\n                </div>\n                <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-xl tracking-tight\" data-kid=\"10\">Springtunes</span>\n            </div>\n            \n            <div class=\"hidden md:flex items-center gap-8 text-sm font-semibold text-[#111827]/60\" data-kid=\"11\">\n                <a href=\"#hero\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"12\">Vision</a>\n                <a href=\"#identity\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"13\">Identity</a>\n                <a href=\"#mockup\" class=\"hover:text-[#22C55E] transition-colors\" data-kid=\"14\">Mockup</a>\n                <a href=\"#download\" class=\"bg-[#111827] text-white px-5 py-2.5 rounded-full hover:bg-[#22C55E] transition-all\" data-kid=\"15\">Brand Kit</a>\n            </div>\n        </div>\n    </nav>\n\n    \n    <section id=\"hero\" class=\"pt-32 pb-20 lg:pt-48 lg:pb-32 px-6 overflow-hidden\" data-kid=\"16\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\" data-kid=\"17\">\n            \n            \n            <div class=\"relative order-2 lg:order-1 flex justify-center\" data-kid=\"18\">\n                <div class=\"relative w-full max-w-lg aspect-square bg-[#22C55E] rounded-full flex items-center justify-center shadow-2xl group\" data-kid=\"19\">\n                    <svg viewBox=\"0 0 100 100\" class=\"w-[60%] h-[60%] hero-main-logo\" data-kid=\"20\">\n                        <path class=\"draw-path\" d=\"M35 65 V45\" stroke=\"white\" stroke-width=\"8\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"21\"></path>\n                        <path class=\"draw-path\" d=\"M50 75 V25\" stroke=\"white\" stroke-width=\"8\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"22\"></path>\n                        <path class=\"draw-path\" d=\"M65 68 V50 Q65 35 78 32\" stroke=\"white\" stroke-width=\"8\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"23\"></path>\n                    </svg>\n                </div>\n            </div>\n\n            \n            <div class=\"order-1 lg:order-2 flex flex-col gap-6\" data-kid=\"24\">\n                <h1 class=\"fade-up-item font-['Plus_Jakarta_Sans'] text-7xl lg:text-8xl font-extrabold leading-[0.9] tracking-tighter text-[#111827]\" data-kid=\"25\">\n                    Springtunes\n                </h1>\n                <div class=\"fade-up-item flex flex-col gap-6\" data-kid=\"26\">\n                    <p class=\"text-2xl lg:text-3xl font-medium text-[#111827]/60 leading-tight\" data-kid=\"27\">\n                        Music that grows on you.\n                    </p>\n                    <p class=\"max-w-lg text-[#111827]/50 text-lg leading-relaxed\" data-kid=\"28\">\n                        A modern, minimalist evolution where digital soundwaves bloom into organic growth. Designed for the next generation of listeners.\n                    </p>\n                </div>\n                <div class=\"fade-up-item flex flex-wrap gap-4 mt-4\" data-kid=\"29\">\n                    <button class=\"px-8 py-4 bg-[#111827] text-white rounded-2xl font-bold text-lg hover:bg-[#22C55E] hover:scale-105 transition-all duration-300 shadow-xl shadow-black/10\" data-kid=\"30\">\n                        Launch Experience\n                    </button>\n                    <button class=\"px-8 py-4 bg-white border-2 border-[#111827]/10 text-[#111827] rounded-2xl font-bold text-lg hover:border-[#111827] transition-all\" data-kid=\"31\">\n                        Brand Guidelines\n                    </button>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"identity\" class=\"py-24 bg-[#111827] text-white\" data-kid=\"32\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"33\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end gap-8 mb-16\" data-kid=\"34\">\n                <div class=\"max-w-2xl\" data-kid=\"35\">\n                    <h2 class=\"font-['Plus_Jakarta_Sans'] text-5xl font-bold mb-6\" data-kid=\"36\">The Soundwave Leaf</h2>\n                    <p class=\"text-white/60 text-lg\" data-kid=\"37\">\n                        Our icon represents the intersection of technology and biology. Three vertical bars — the universal symbol for digital audio — are meticulously sculpted to form the silhouette of a spring leaf.\n                    </p>\n                </div>\n                <div class=\"flex gap-4\" data-kid=\"38\">\n                    <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center text-white/40 hover:text-[#22C55E] hover:border-[#22C55E] cursor-pointer transition-colors\" data-kid=\"39\">\n                        <i class=\"ti ti-arrow-left text-xl\" data-kid=\"40\"></i>\n                    </div>\n                    <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center text-white/40 hover:text-[#22C55E] hover:border-[#22C55E] cursor-pointer transition-colors\" data-kid=\"41\">\n                        <i class=\"ti ti-arrow-right text-xl\" data-kid=\"42\"></i>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"flex flex-col gap-8\" data-kid=\"43\">\n                \n                <div class=\"h-[400px] w-full rounded-[3rem] bg-[#22C55E] relative overflow-hidden flex items-center justify-center variation-main\" data-kid=\"44\">\n                    <div class=\"relative w-56 h-56 bg-white/10 rounded-full flex items-center justify-center border border-white/20 shadow-2xl\" data-kid=\"45\">\n                        <svg viewBox=\"0 0 100 100\" class=\"w-[60%] h-[60%]\" data-kid=\"46\">\n                            <path d=\"M35 65 V45\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"47\"></path>\n                            <path d=\"M50 75 V25\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"48\"></path>\n                            <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"49\"></path>\n                        </svg>\n                    </div>\n                    <div class=\"absolute bottom-10 left-10\" data-kid=\"50\">\n                        <p class=\"text-[0.6rem] font-bold tracking-[0.4em] opacity-50 mb-1 uppercase text-white\" data-kid=\"51\">Master Identity</p>\n                        <h4 class=\"text-4xl font-extrabold text-white\" data-kid=\"52\">Vibrant Spring</h4>\n                    </div>\n                </div>\n\n                \n                <div class=\"flex flex-wrap lg:flex-nowrap gap-6\" data-kid=\"53\">\n                    \n                    <div class=\"variation-card flex-1 min-w-[200px] h-48 bg-white/5 border border-white/10 rounded-[2.5rem] flex flex-col items-center justify-center group hover:bg-white cursor-pointer p-6\" data-kid=\"54\">\n                        <div class=\"w-16 h-16 rounded-full bg-[#111827] flex items-center justify-center p-4 mb-4\" data-kid=\"55\">\n                            <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"56\">\n                                <path d=\"M35 65 V45\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"57\"></path>\n                                <path d=\"M50 75 V25\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"58\"></path>\n                                <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"59\"></path>\n                            </svg>\n                        </div>\n                        <span class=\"text-[10px] font-bold tracking-widest opacity-40 group-hover:text-[#111827] group-hover:opacity-100 uppercase\" data-kid=\"60\">Ink Mono</span>\n                    </div>\n                    \n                    <div class=\"variation-card flex-1 min-w-[200px] h-48 bg-white/5 border border-white/10 rounded-[2.5rem] flex flex-col items-center justify-center group hover:border-[#22C55E] cursor-pointer p-6\" data-kid=\"61\">\n                        <svg viewBox=\"0 0 100 100\" class=\"w-14 h-14 opacity-70 group-hover:opacity-100 mb-4\" data-kid=\"62\">\n                            <path d=\"M35 65 V45\" stroke=\"#22C55E\" stroke-width=\"8\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"63\"></path>\n                            <path d=\"M50 75 V25\" stroke=\"#22C55E\" stroke-width=\"8\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"64\"></path>\n                            <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"#22C55E\" stroke-width=\"8\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"65\"></path>\n                        </svg>\n                        <span class=\"text-[10px] font-bold tracking-widest opacity-40 group-hover:opacity-100 uppercase\" data-kid=\"66\">Outline Green</span>\n                    </div>\n                    \n                    <div class=\"variation-card flex-1 min-w-[200px] h-48 bg-white rounded-[2.5rem] flex flex-col items-center justify-center shadow-xl hover:shadow-[#22C55E]/20 cursor-pointer p-6\" data-kid=\"67\">\n                        <div class=\"w-14 h-14 rounded-2xl bg-[#22C55E] flex items-center justify-center p-3 shadow-lg shadow-[#22C55E]/30 mb-4\" data-kid=\"68\">\n                            <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"69\">\n                                <path d=\"M35 65 V45\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"70\"></path>\n                                <path d=\"M50 75 V25\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"71\"></path>\n                                <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"72\"></path>\n                            </svg>\n                        </div>\n                        <span class=\"text-[10px] font-bold tracking-widest text-[#111827]/40 uppercase\" data-kid=\"73\">App Icon</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"mockup\" class=\"py-24 px-6 overflow-hidden\" data-kid=\"74\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"75\">\n            \n            <div class=\"flex flex-col gap-8\" data-kid=\"76\">\n                <h2 class=\"font-['Plus_Jakarta_Sans'] text-5xl font-bold leading-tight\" data-kid=\"77\">Always on your home screen.</h2>\n                <p class=\"text-xl text-[#111827]/60 leading-relaxed\" data-kid=\"78\">\n                    Designed to be distinctive in any environment. Springtunes stands out with its vibrant green and unique silhouette, making it instantly recognizable among a sea of standard apps.\n                </p>\n                <div class=\"space-y-6\" data-kid=\"79\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"80\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E]\" data-kid=\"81\">\n                            <i class=\"ti ti-circle-check text-2xl\" data-kid=\"82\"></i>\n                        </div>\n                        <div data-kid=\"83\">\n                            <h5 class=\"font-bold text-lg\" data-kid=\"84\">High Visibility</h5>\n                            <p class=\"text-[#111827]/50\" data-kid=\"85\">Engineered for legibility at small favicon sizes.</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-4\" data-kid=\"86\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-[#22C55E]/10 flex items-center justify-center text-[#22C55E]\" data-kid=\"87\">\n                            <i class=\"ti ti-leaf text-2xl\" data-kid=\"88\"></i>\n                        </div>\n                        <div data-kid=\"89\">\n                            <h5 class=\"font-bold text-lg\" data-kid=\"90\">Eco-conscious Vibe</h5>\n                            <p class=\"text-[#111827]/50\" data-kid=\"91\">A fresh alternative to corporate blues and reds.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"relative flex justify-center\" data-kid=\"92\">\n                \n                <div class=\"w-[320px] h-[640px] bg-[#111827] rounded-[3rem] p-4 border-[8px] border-[#111827] shadow-2xl relative\" data-kid=\"93\">\n                    <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-32 h-6 bg-[#111827] rounded-b-2xl\" data-kid=\"94\"></div>\n                    <div class=\"w-full h-full bg-[#111827] rounded-[2.2rem] overflow-hidden relative\" data-kid=\"95\">\n                        \n                        <div class=\"absolute inset-0 bg-gradient-to-b from-[#111827] via-[#1a1a1a] to-[#22C55E]/20\" data-kid=\"96\"></div>\n                        \n                        \n                        <div class=\"relative p-6 grid grid-cols-4 gap-x-4 gap-y-6 mt-12\" data-kid=\"97\">\n                            \n                            <div class=\"flex flex-col items-center gap-1.5 opacity-40\" data-kid=\"98\">\n                                <div class=\"aspect-square w-full bg-white/10 rounded-2xl\" data-kid=\"99\"></div>\n                                <div class=\"w-8 h-1 bg-white/20 rounded-full\" data-kid=\"100\"></div>\n                            </div>\n                            <div class=\"flex flex-col items-center gap-1.5 opacity-40\" data-kid=\"101\">\n                                <div class=\"aspect-square w-full bg-white/10 rounded-2xl\" data-kid=\"102\"></div>\n                                <div class=\"w-10 h-1 bg-white/20 rounded-full\" data-kid=\"103\"></div>\n                            </div>\n                            <div class=\"flex flex-col items-center gap-1.5 opacity-40\" data-kid=\"104\">\n                                <div class=\"aspect-square w-full bg-white/10 rounded-2xl\" data-kid=\"105\"></div>\n                                <div class=\"w-6 h-1 bg-white/20 rounded-full\" data-kid=\"106\"></div>\n                            </div>\n                            \n                            <div class=\"flex flex-col items-center gap-1.5\" data-kid=\"107\">\n                                <div class=\"aspect-square w-full bg-[#22C55E] rounded-2xl flex items-center justify-center p-2 shadow-lg shadow-[#22C55E]/40\" data-kid=\"108\">\n                                    <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"109\">\n                                        <path d=\"M35 65 V45\" stroke=\"white\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"110\"></path>\n                                        <path d=\"M50 75 V25\" stroke=\"white\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"111\"></path>\n                                        <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"white\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"112\"></path>\n                                    </svg>\n                                </div>\n                                <div class=\"w-12 h-1 bg-[#22C55E] rounded-full\" data-kid=\"113\"></div>\n                            </div>\n                            <div class=\"flex flex-col items-center gap-1.5 opacity-20\" data-kid=\"114\">\n                                <div class=\"aspect-square w-full bg-white/10 rounded-2xl\" data-kid=\"115\"></div>\n                                <div class=\"w-9 h-1 bg-white/20 rounded-full\" data-kid=\"116\"></div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"absolute bottom-6 left-4 right-4 h-16 bg-white/10 backdrop-blur-md rounded-3xl flex items-center justify-around px-4\" data-kid=\"117\">\n                             <div class=\"w-10 h-10 bg-white/10 rounded-xl\" data-kid=\"118\"></div>\n                             <div class=\"w-10 h-10 bg-white/10 rounded-xl\" data-kid=\"119\"></div>\n                             <div class=\"w-10 h-10 bg-white/10 rounded-xl\" data-kid=\"120\"></div>\n                             <div class=\"w-10 h-10 bg-[#22C55E]/10 border border-[#22C55E]/20 rounded-xl flex items-center justify-center\" data-kid=\"121\">\n                                <svg viewBox=\"0 0 100 100\" class=\"w-5 h-5\" data-kid=\"122\">\n                                    <path d=\"M35 65 V45\" stroke=\"#22C55E\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"123\"></path>\n                                    <path d=\"M50 75 V25\" stroke=\"#22C55E\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"124\"></path>\n                                    <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"#22C55E\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"125\"></path>\n                                </svg>\n                             </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"py-12 border-t border-[#111827]/5\" data-kid=\"126\">\n        <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"127\">\n            <div class=\"flex items-center gap-3\" data-kid=\"128\">\n                <div class=\"w-8 h-8 rounded-full bg-[#22C55E] flex items-center justify-center p-1.5\" data-kid=\"129\">\n                    <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"130\">\n                        <path d=\"M35 65 V45\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"131\"></path>\n                        <path d=\"M50 75 V25\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"132\"></path>\n                        <path d=\"M65 68 V50 Q65 35 78 32\" stroke=\"white\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\" data-kid=\"133\"></path>\n                    </svg>\n                </div>\n                <span class=\"font-['Plus_Jakarta_Sans'] font-bold text-lg\" data-kid=\"134\">Springtunes</span>\n            </div>\n            <p class=\"text-[#111827]/40 text-sm\" data-kid=\"135\">© 2024 Springtunes Brand Identity. All rights reserved.</p>\n            <div class=\"flex gap-6\" data-kid=\"136\">\n                <a href=\"#\" class=\"text-[#111827]/40 hover:text-[#22C55E]\" data-kid=\"137\"><i class=\"ti ti-brand-x\" data-kid=\"138\"></i></a>\n                <a href=\"#\" class=\"text-[#111827]/40 hover:text-[#22C55E]\" data-kid=\"139\"><i class=\"ti ti-brand-instagram\" data-kid=\"140\"></i></a>\n                <a href=\"#\" class=\"text-[#111827]/40 hover:text-[#22C55E]\" data-kid=\"141\"><i class=\"ti ti-brand-dribbble\" data-kid=\"142\"></i></a>\n            </div>\n        </div>\n    </footer>\n\n    \n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"143\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"144\">\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"145\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"146\"></script>\n    <script type=\"module\" data-kid=\"147\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        import { animate as animeAnimate, svg } from \"https://esm.sh/animejs@4\";\n        import { animate, hover, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n\n        // Initialize Lenis\n        const lenis = new Lenis();\n        function raf(time) {\n          lenis.raf(time);\n          requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n        \n        // GSAP Fade Up Entrance\n        gsap.registerPlugin(ScrollTrigger);\n        \n        gsap.from(\".fade-up-item\", {\n            autoAlpha: 0,\n            y: 40,\n            duration: 1,\n            stagger: 0.15,\n            ease: \"power4.out\",\n            scrollTrigger: {\n                trigger: \"#hero\",\n                start: \"top 80%\",\n            }\n        });\n\n        // Anime Path Draw for Hero Logo (#anime-path-draw)\n        inView(\".hero-main-logo\", ({ target }) => {\n            const drawables = Array.from(target.querySelectorAll(\".draw-path\")).map(p => svg.createDrawable(p));\n            drawables.forEach((drawable, i) => {\n                animeAnimate(drawable, { \n                    draw: [\"0 0\", \"0 1\"], \n                    duration: 1200, \n                    delay: 200 + (i * 150),\n                    ease: \"inOut(3)\" \n                });\n            });\n        });\n\n        // Motion Hover Lift for Variation Cards (#motion-hover-lift)\n        hover(\".variation-card\", (el) => {\n            animate(el, { y: -8, scale: 1.02 }, { type: \"spring\", stiffness: 400, damping: 25 });\n            return () => animate(el, { y: 0, scale: 1 }, { type: \"spring\", stiffness: 300, damping: 30 });\n        });\n\n        // Button hover interactions\n        hover(\"button\", (el) => {\n            animate(el, { scale: 1.05 }, { type: \"spring\", stiffness: 400, damping: 10 });\n            return () => animate(el, { scale: 1 }, { type: \"spring\", stiffness: 300, damping: 15 });\n        });\n\n        // Identity section reveal\n        gsap.from(\"#identity h2, #identity p\", {\n            autoAlpha: 0,\n            y: 30,\n            duration: 0.8,\n            stagger: 0.2,\n            scrollTrigger: {\n                trigger: \"#identity\",\n                start: \"top 70%\",\n            }\n        });\n\n        gsap.from(\".variation-main\", {\n            autoAlpha: 0,\n            scale: 0.95,\n            duration: 1.2,\n            ease: \"expo.out\",\n            scrollTrigger: {\n                trigger: \"#identity\",\n                start: \"top 60%\",\n            }\n        });\n\n        gsap.from(\".variation-card\", {\n            autoAlpha: 0,\n            y: 20,\n            duration: 0.6,\n            stagger: 0.1,\n            scrollTrigger: {\n                trigger: \".grid-cols-2\",\n                start: \"top 80%\",\n            }\n        });\n\n    </script>\n</div>\n",
