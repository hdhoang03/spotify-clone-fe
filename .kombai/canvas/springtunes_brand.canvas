      "html": "\n<div class=\"bg-[#F8F9FA] min-h-screen font-['Instrument_Sans'] text-[#334155] overflow-x-clip selection:bg-[#22C55E]/20\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;600;700&family=Be+Vietnam+Pro:wght@300;400;500&display=swap');\n\n        /* Custom styles for grid and layout */\n        .swiss-grid-container {\n            display: grid;\n            grid-template-columns: repeat(6, 1fr);\n            grid-template-rows: repeat(4, 1fr);\n            height: 100vh;\n            width: 100vw;\n            border-left: 1px solid rgba(51, 65, 85, 0.1);\n            border-top: 1px solid rgba(51, 65, 85, 0.1);\n        }\n\n        .grid-cell {\n            border-right: 1px solid rgba(51, 65, 85, 0.15);\n            border-bottom: 1px solid rgba(51, 65, 85, 0.15);\n            position: relative;\n        }\n\n        /* Prevent GSAP conflicts */\n        .annotation-text {\n            will-change: transform, opacity;\n        }\n    </style>\n\n    \n    <div class=\"swiss-grid-container fixed inset-0 z-0 pointer-events-none\" id=\"main-grid\" data-kid=\"2\">\n        \n        <div class=\"grid-cell\" data-kid=\"3\"></div><div class=\"grid-cell\" data-kid=\"4\"></div><div class=\"grid-cell\" data-kid=\"5\"></div><div class=\"grid-cell\" data-kid=\"6\"></div><div class=\"grid-cell\" data-kid=\"7\"></div><div class=\"grid-cell\" data-kid=\"8\"></div>\n        <div class=\"grid-cell\" data-kid=\"9\"></div><div class=\"grid-cell\" data-kid=\"10\"></div><div class=\"grid-cell\" data-kid=\"11\"></div><div class=\"grid-cell\" data-kid=\"12\"></div><div class=\"grid-cell\" data-kid=\"13\"></div><div class=\"grid-cell\" data-kid=\"14\"></div>\n        <div class=\"grid-cell\" data-kid=\"15\"></div><div class=\"grid-cell\" data-kid=\"16\"></div><div class=\"grid-cell\" data-kid=\"17\"></div><div class=\"grid-cell\" data-kid=\"18\"></div><div class=\"grid-cell\" data-kid=\"19\"></div><div class=\"grid-cell\" data-kid=\"20\"></div>\n        <div class=\"grid-cell\" data-kid=\"21\"></div><div class=\"grid-cell\" data-kid=\"22\"></div><div class=\"grid-cell\" data-kid=\"23\"></div><div class=\"grid-cell\" data-kid=\"24\"></div><div class=\"grid-cell\" data-kid=\"25\"></div><div class=\"grid-cell\" data-kid=\"26\"></div>\n    </div>\n\n    \n    <main class=\"relative z-10 grid grid-rows-4 h-screen\" data-kid=\"27\">\n        \n        \n        <div class=\"grid grid-cols-6 border-b border-[#334155]/15\" data-kid=\"28\">\n            <div class=\"col-span-2 p-8 border-r border-[#334155]/15\" data-kid=\"29\">\n                <span class=\"text-xs font-bold tracking-[0.2em] uppercase opacity-60\" data-kid=\"30\">Springtunes™ Identity System</span>\n                <h1 class=\"text-5xl font-bold mt-2 leading-none tracking-tighter\" data-kid=\"31\">SPROUTING<br data-kid=\"32\">NOTE</h1>\n            </div>\n            <div class=\"col-span-1 p-8 border-r border-[#334155]/15 flex flex-col justify-end\" data-kid=\"33\">\n                <span class=\"text-[10px] font-mono uppercase opacity-40\" data-kid=\"34\">System Hex</span>\n                <span class=\"text-xl font-mono font-bold text-[#22C55E]\" data-kid=\"35\">#22C55E</span>\n            </div>\n            <div class=\"col-span-1 p-8 border-r border-[#334155]/15 flex flex-col justify-end\" data-kid=\"36\">\n                <span class=\"text-[10px] font-mono uppercase opacity-40\" data-kid=\"37\">Typeface</span>\n                <span class=\"text-sm font-semibold\" data-kid=\"38\">Instrument Sans</span>\n            </div>\n            <div class=\"col-span-2 p-8 flex flex-col justify-end items-end text-right\" data-kid=\"39\">\n                <span class=\"text-[10px] font-mono uppercase opacity-40\" data-kid=\"40\">Classification</span>\n                <span class=\"text-sm font-semibold uppercase tracking-widest\" data-kid=\"41\">Swiss / Int. Typographic Style</span>\n            </div>\n        </div>\n\n        \n        <div class=\"row-span-2 relative flex items-center justify-center overflow-clip border-b border-[#334155]/15\" data-kid=\"42\">\n            <div class=\"relative w-[450px] h-[450px] flex items-center justify-center\" id=\"icon-stage\" data-kid=\"43\">\n                \n                \n                <svg class=\"absolute inset-[-80px] w-[calc(100%+160px)] h-[calc(100%+160px)] pointer-events-none\" viewBox=\"0 0 100 100\" data-kid=\"44\">\n                    <circle cx=\"43\" cy=\"74\" r=\"14\" fill=\"none\" stroke=\"#334155\" stroke-width=\"0.3\" class=\"construction-path opacity-40\" data-kid=\"45\"></circle>\n                    <circle cx=\"68\" cy=\"35\" r=\"20\" fill=\"none\" stroke=\"#334155\" stroke-width=\"0.3\" class=\"construction-path opacity-40\" data-kid=\"46\"></circle>\n                    <circle cx=\"50\" cy=\"50\" r=\"45\" fill=\"none\" stroke=\"#334155\" stroke-width=\"0.1\" stroke-dasharray=\"1 2\" opacity=\"0.2\" data-kid=\"47\"></circle>\n                    <path d=\"M50 5 L50 95\" fill=\"none\" stroke=\"#334155\" stroke-width=\"0.2\" class=\"construction-path opacity-40\" data-kid=\"48\"></path>\n                    <path d=\"M5 50 L95 50\" fill=\"none\" stroke=\"#334155\" stroke-width=\"0.2\" class=\"construction-path opacity-40\" data-kid=\"49\"></path>\n                    \n                    \n                    <line x1=\"32\" y1=\"78\" x2=\"5\" y2=\"78\" stroke=\"#334155\" stroke-width=\"0.3\" stroke-dasharray=\"2 1\" opacity=\"0.3\" data-kid=\"50\"></line>\n                    <line x1=\"72\" y1=\"28\" x2=\"95\" y2=\"28\" stroke=\"#334155\" stroke-width=\"0.3\" stroke-dasharray=\"2 1\" opacity=\"0.3\" data-kid=\"51\"></line>\n                </svg>\n\n                \n                <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"52\">\n                    \n                    <ellipse cx=\"43\" cy=\"78\" rx=\"14\" ry=\"10\" fill=\"#22C55E\" transform=\"rotate(-25 43 78)\" data-kid=\"53\"></ellipse>\n                    \n                    <path d=\"M52 20 L52 74 Q52 78 46 78\" fill=\"none\" stroke=\"#22C55E\" stroke-width=\"4.5\" stroke-linecap=\"round\" data-kid=\"54\"></path>\n                    \n                    <path d=\"M52 20 C 72 18, 92 35, 80 58 C 70 75, 52 55, 52 20\" fill=\"#22C55E\" data-kid=\"55\"></path>\n                </svg>\n\n                \n                <div class=\"absolute left-[-220px] bottom-[18%] w-64 annotation-text\" id=\"annot-seed\" data-kid=\"56\">\n                    <div class=\"flex items-center gap-2 mb-1\" data-kid=\"57\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#22C55E]\" data-kid=\"58\"></span>\n                        <h4 class=\"text-[10px] font-black uppercase tracking-[0.15em]\" data-kid=\"59\">Seed Note Head</h4>\n                    </div>\n                    <p class=\"font-['Be_Vietnam_Pro'] text-[11px] leading-relaxed text-[#334155]/60 uppercase tracking-tight\" data-kid=\"60\">\n                        Note head ellipse slanted precisely at -25° on the horizontal axis. Geometric anchor for the primary frequency curve.\n                    </p>\n                </div>\n\n                <div class=\"absolute right-[-240px] top-[22%] w-64 annotation-text\" id=\"annot-leaf\" data-kid=\"61\">\n                    <div class=\"flex items-center gap-2 mb-1\" data-kid=\"62\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#22C55E]\" data-kid=\"63\"></span>\n                        <h4 class=\"text-[10px] font-black uppercase tracking-[0.15em]\" data-kid=\"64\">Leaf Flag</h4>\n                    </div>\n                    <p class=\"font-['Be_Vietnam_Pro'] text-[11px] leading-relaxed text-[#334155]/60 uppercase tracking-tight\" data-kid=\"65\">\n                        Flag curve aligns with outer 45px construction radius. Organic bezier path optimized for 1:1 aspect ratio scalability.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-6 bg-[#F8F9FA]\" data-kid=\"66\">\n            <div class=\"col-span-2 p-8 border-r border-[#334155]/15 flex flex-col justify-between\" data-kid=\"67\">\n                <div data-kid=\"68\">\n                    <h3 class=\"text-xl font-bold tracking-tighter uppercase\" data-kid=\"69\">Scalability Geometry</h3>\n                    <p class=\"text-[11px] font-['Be_Vietnam_Pro'] opacity-60 mt-2 max-w-[200px]\" data-kid=\"70\">\n                        Visual weight maintained through vector precision at minimal scale increments.\n                    </p>\n                </div>\n                <div class=\"flex gap-4 opacity-30 text-[10px] font-mono\" data-kid=\"71\">\n                    <span data-kid=\"72\">OPTIMIZED FOR: 16PX / 32PX / 128PX / 1024PX</span>\n                </div>\n            </div>\n            \n            \n            <div class=\"col-span-4 grid grid-cols-4\" data-kid=\"73\">\n                \n                <div class=\"p-8 border-r border-[#334155]/15 flex flex-col items-center justify-center\" data-kid=\"74\">\n                    <div class=\"w-32 h-32 flex items-center justify-center\" data-kid=\"75\">\n                        <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"76\">\n                            <ellipse cx=\"43\" cy=\"78\" rx=\"13\" ry=\"9\" fill=\"#22C55E\" transform=\"rotate(-25 43 78)\" data-kid=\"77\"></ellipse>\n                            <path d=\"M52 20 L52 75 Q52 78 48 78\" fill=\"none\" stroke=\"#22C55E\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"78\"></path>\n                            <path d=\"M52 20 C 75 15, 88 40, 78 55 C 68 70, 52 50, 52 20\" fill=\"#22C55E\" data-kid=\"79\"></path>\n                        </svg>\n                    </div>\n                    <span class=\"mt-4 text-[10px] font-mono opacity-40\" data-kid=\"80\">128PX PRIMARY</span>\n                </div>\n\n                \n                <div class=\"p-8 border-r border-[#334155]/15 flex flex-col items-center justify-center\" data-kid=\"81\">\n                    <div class=\"w-16 h-16 flex items-center justify-center\" data-kid=\"82\">\n                        <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"83\">\n                            <ellipse cx=\"43\" cy=\"78\" rx=\"13\" ry=\"9\" fill=\"#22C55E\" transform=\"rotate(-25 43 78)\" data-kid=\"84\"></ellipse>\n                            <path d=\"M52 20 L52 75 Q52 78 48 78\" fill=\"none\" stroke=\"#22C55E\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"85\"></path>\n                            <path d=\"M52 20 C 75 15, 88 40, 78 55 C 68 70, 52 50, 52 20\" fill=\"#22C55E\" data-kid=\"86\"></path>\n                        </svg>\n                    </div>\n                    <span class=\"mt-4 text-[10px] font-mono opacity-40\" data-kid=\"87\">64PX UI</span>\n                </div>\n\n                \n                <div class=\"p-8 border-r border-[#334155]/15 flex flex-col items-center justify-center\" data-kid=\"88\">\n                    <div class=\"w-4 h-4 flex items-center justify-center bg-[#22C55E]/5 ring-1 ring-[#22C55E]/20\" data-kid=\"89\">\n                        <svg viewBox=\"0 0 100 100\" class=\"w-full h-full\" data-kid=\"90\">\n                            <ellipse cx=\"43\" cy=\"78\" rx=\"13\" ry=\"9\" fill=\"#22C55E\" transform=\"rotate(-25 43 78)\" data-kid=\"91\"></ellipse>\n                            <path d=\"M52 20 L52 75 Q52 78 48 78\" fill=\"none\" stroke=\"#22C55E\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"92\"></path>\n                            <path d=\"M52 20 C 75 15, 88 40, 78 55 C 68 70, 52 50, 52 20\" fill=\"#22C55E\" data-kid=\"93\"></path>\n                        </svg>\n                    </div>\n                    <span class=\"mt-4 text-[10px] font-mono opacity-60\" data-kid=\"94\">16PX FAVICON</span>\n                </div>\n\n                \n                <div class=\"p-8 flex flex-col justify-center items-start\" data-kid=\"95\">\n                    <div class=\"space-y-4 w-full\" data-kid=\"96\">\n                        <div data-kid=\"97\">\n                            <div class=\"text-[9px] font-mono opacity-40 uppercase tracking-widest mb-1\" data-kid=\"98\">Aspect Ratio</div>\n                            <div class=\"text-sm font-black uppercase\" data-kid=\"99\">1:1 Square</div>\n                        </div>\n                        <div class=\"h-px bg-[#334155]/10\" data-kid=\"100\"></div>\n                        <div data-kid=\"101\">\n                            <div class=\"text-[9px] font-mono opacity-40 uppercase tracking-widest mb-1\" data-kid=\"102\">Render Path</div>\n                            <div class=\"text-sm font-black uppercase\" data-kid=\"103\">Solid Vector</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"104\"></script>\n    <script type=\"module\" data-kid=\"105\">\n        import { animate, stagger } from 'https://esm.sh/animejs@4';\n        import { animate as motionAnimate } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        // 1. anime-stagger-grid background reveal\n        animate('.grid-cell', {\n            opacity: [0, 1],\n            scale: [0.95, 1],\n            delay: stagger(40, { grid: [6, 4], from: 'center' }),\n            duration: 800,\n            ease: 'out(3)'\n        });\n\n        // 2. gsap-slide-in-side for annotations\n        gsap.from('#annot-seed', {\n            autoAlpha: 0,\n            xPercent: -30,\n            duration: 1.2,\n            ease: 'power4.out',\n            delay: 0.8\n        });\n        gsap.from('#annot-leaf', {\n            autoAlpha: 0,\n            xPercent: 30,\n            duration: 1.2,\n            ease: 'power4.out',\n            delay: 1.0\n        });\n\n        // 3. motion-svg-effect-draw-loop for construction lines\n        const paths = document.querySelectorAll('.construction-path');\n        paths.forEach(path => {\n            const length = path.getTotalLength();\n            path.style.strokeDasharray = `${length * 0.2} ${length * 0.8}`;\n            \n            motionAnimate(0, 1, {\n                onUpdate: progress => {\n                    path.style.strokeDashoffset = -progress * length;\n                },\n                duration: 6,\n                repeat: Infinity,\n                ease: \"linear\"\n            });\n        });\n\n        // Entrance for the main icon\n        gsap.from('#icon-stage svg:nth-child(2)', {\n            scale: 0.8,\n            autoAlpha: 0,\n            duration: 1.5,\n            ease: 'elastic.out(1, 0.5)',\n            delay: 0.4\n        });\n    </script>\n</div>\n",
