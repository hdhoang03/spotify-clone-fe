      "html": "\n<section class=\"relative min-h-screen bg-[#1A1A1A] text-white font-['Space_Grotesk'] overflow-hidden selection:bg-[#22C55E] selection:text-[#1A1A1A]\" data-kid=\"0\">\n    <style data-kid=\"1\">\n        @import url('https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        .neobrutal-shadow {\n            box-shadow: 8px 8px 0px 0px #FFFFFF;\n        }\n\n        .neobrutal-shadow-green {\n            box-shadow: 8px 8px 0px 0px #22C55E;\n        }\n\n        .squircle {\n            border-radius: 30%;\n        }\n\n        /* Prevent layout shift during animation */\n        #giant-headline span, #logo-p {\n            display: inline-block;\n            vertical-align: middle;\n            line-height: 0.8;\n        }\n        \n        #dock-container {\n            z-index: 100;\n        }\n\n        .bg-noise {\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n            opacity: 0.05;\n        }\n    </style>\n\n    \n    <nav class=\"absolute top-0 left-0 w-full p-8 flex justify-between items-center z-50\" data-kid=\"2\">\n        <div class=\"flex items-center gap-2\" data-kid=\"3\">\n            <div class=\"w-8 h-8 bg-[#22C55E] squircle flex items-center justify-center\" data-kid=\"4\">\n                <svg viewBox=\"0 0 100 100\" class=\"w-4 h-4 fill-white\" data-kid=\"5\">\n                    <path d=\"M 28 35 C 22 10 45 15 45 35 L 82 55 L 28 80 Z\" data-kid=\"6\"></path>\n                </svg>\n            </div>\n            <span class=\"font-bold tracking-tight text-xl uppercase\" data-kid=\"7\">Springtunes</span>\n        </div>\n        <div class=\"hidden md:flex gap-8 text-sm font-medium uppercase tracking-widest opacity-70\" data-kid=\"8\">\n            <a href=\"#\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"9\">Manifesto</a>\n            <a href=\"#\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"10\">Artists</a>\n            <a href=\"#\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"11\">Premium</a>\n        </div>\n        <button class=\"bg-[#22C55E] text-[#1A1A1A] px-6 py-2 rounded-full font-bold uppercase text-sm hover:scale-105 transition-transform active:scale-95\" data-kid=\"12\">\n            Get App\n        </button>\n    </nav>\n\n    \n    <main class=\"flex flex-col items-center justify-center min-h-screen pt-24 pb-48 relative\" data-kid=\"13\">\n        <div class=\"bg-noise absolute inset-0 pointer-events-none\" data-kid=\"14\"></div>\n        \n        \n        <div class=\"w-full max-w-[1900px] px-4 overflow-hidden\" data-kid=\"15\">\n            <h1 id=\"giant-headline\" class=\"font-['Anton'] text-[22vw] leading-[0.65] text-center flex flex-nowrap items-center justify-center gap-x-0 tracking-[-0.06em] uppercase select-none\" data-kid=\"16\">\n                <span class=\"headline-char\" data-kid=\"17\">S</span>\n                <div id=\"logo-p\" class=\"w-[15vw] h-[15vw] bg-[#22C55E] squircle inline-flex items-center justify-center mx-[-0.85vw] border-[0.7vw] border-black shadow-[1.2vw_1.2vw_0px_0px_#FFFFFF] relative z-10 translate-y-[-0.5vw]\" data-kid=\"18\">\n                    <svg viewBox=\"0 0 100 100\" class=\"w-[8vw] h-[8vw] fill-white\" data-kid=\"19\">\n                        \n                        <path d=\"M 32 32 C 15 5 50 15 50 35 L 82 52 L 32 80 Z\" data-kid=\"20\"></path>\n                    </svg>\n                </div>\n                <span class=\"headline-char\" data-kid=\"21\">RINGTUNES</span>\n            </h1>\n        </div>\n\n        \n        <div class=\"mt-20 text-center max-w-4xl px-6 relative z-10\" data-kid=\"22\">\n            <p id=\"hero-sub\" class=\"text-3xl md:text-5xl font-black mb-12 leading-none uppercase tracking-tighter text-white\" data-kid=\"23\">\n                <span class=\"bg-[#22C55E] text-[#1A1A1A] px-3 py-1\" data-kid=\"24\">UNLEASH</span> THE <span class=\"italic underline decoration-8 underline-offset-8\" data-kid=\"25\">WILD</span> SOUND.\n            </p>\n            <div id=\"hero-btns\" class=\"flex flex-wrap justify-center items-center gap-10\" data-kid=\"26\">\n                <a href=\"#\" class=\"group relative bg-[#FFFFFF] text-[#1A1A1A] px-16 py-6 font-black uppercase tracking-tighter text-3xl border-6 border-black shadow-[12px_12px_0px_0px_#22C55E] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all duration-75\" data-kid=\"27\">\n                    HEAR IT NOW\n                </a>\n                <a href=\"#\" class=\"relative flex items-center gap-4 group\" data-kid=\"28\">\n                    <span class=\"w-16 h-16 rounded-full border-4 border-white flex items-center justify-center group-hover:bg-white group-hover:text-black transition-all\" data-kid=\"29\">\n                        <i class=\"ti ti-arrow-right text-2xl\" data-kid=\"30\"></i>\n                    </span>\n                    <span class=\"font-bold text-xl uppercase tracking-widest border-b-4 border-white\" data-kid=\"31\">The Manifesto</span>\n                </a>\n            </div>\n        </div>\n    </main>\n\n    \n    <section class=\"w-full grid grid-cols-1 md:grid-cols-2 border-y-8 border-black\" data-kid=\"32\">\n        \n        <div class=\"bg-[#1A1A1A] p-32 flex flex-col items-center justify-center group border-b-8 md:border-b-0 md:border-r-8 border-black overflow-hidden relative\" data-kid=\"33\">\n            <div class=\"absolute top-8 left-8 text-[#22C55E] font-black text-6xl opacity-20 uppercase italic select-none\" data-kid=\"34\">Contrast</div>\n            <div class=\"brand-reveal-left w-72 h-72 bg-[#22C55E] squircle flex items-center justify-center shadow-[24px_24px_0px_0px_#FFFFFF] border-4 border-black group-hover:scale-105 transition-transform duration-500\" data-kid=\"35\">\n                 <svg viewBox=\"0 0 100 100\" class=\"w-36 h-36 fill-white\" data-kid=\"36\">\n                    <path d=\"M 32 32 C 15 5 50 15 50 35 L 82 52 L 32 80 Z\" data-kid=\"37\"></path>\n                </svg>\n            </div>\n            <h3 class=\"mt-16 font-['Anton'] text-5xl uppercase tracking-widest text-[#22C55E]\" data-kid=\"38\">Midnight Mode</h3>\n            <p class=\"mt-4 text-xl font-medium opacity-60 text-center\" data-kid=\"39\">Brutal clarity for the deep listen.</p>\n        </div>\n        \n        <div class=\"bg-white p-32 flex flex-col items-center justify-center group overflow-hidden relative\" data-kid=\"40\">\n            <div class=\"absolute top-8 right-8 text-[#1A1A1A] font-black text-6xl opacity-20 uppercase italic select-none\" data-kid=\"41\">Bloom</div>\n             <div class=\"brand-reveal-right w-72 h-72 bg-[#22C55E] squircle flex items-center justify-center shadow-[24px_24px_0px_0px_#1A1A1A] border-4 border-black group-hover:scale-105 transition-transform duration-500\" data-kid=\"42\">\n                 <svg viewBox=\"0 0 100 100\" class=\"w-36 h-36 fill-white\" data-kid=\"43\">\n                    <path d=\"M 32 32 C 15 5 50 15 50 35 L 82 52 L 32 80 Z\" data-kid=\"44\"></path>\n                </svg>\n            </div>\n            <h3 class=\"mt-16 font-['Anton'] text-5xl uppercase tracking-widest text-[#1A1A1A]\" data-kid=\"45\">Spring Bloom</h3>\n            <p class=\"mt-4 text-xl font-medium opacity-60 text-[#1A1A1A] text-center\" data-kid=\"46\">Pure energy. No distractions.</p>\n        </div>\n    </section>\n\n    \n    <footer class=\"p-20 text-center border-t-8 border-black bg-[#22C55E]\" data-kid=\"47\">\n        <h2 class=\"font-['Anton'] text-[10vw] text-[#1A1A1A] uppercase leading-none\" data-kid=\"48\">Stay Fresh</h2>\n        <p class=\"text-[#1A1A1A] font-bold text-xl mt-4\" data-kid=\"49\">© 2024 SPRINGTUNES MUSIC GROUP</p>\n    </footer>\n\n    \n    <div id=\"dock-container\" class=\"fixed bottom-10 left-1/2 -translate-x-1/2 flex items-end gap-4 p-4 bg-[#1A1A1A]/80 backdrop-blur-2xl border-4 border-black rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.5)]\" data-kid=\"50\">\n        <div class=\"dock-item w-16 h-16 bg-white/10 rounded-[1.5rem] flex items-center justify-center text-white cursor-pointer overflow-hidden border border-white/5\" data-kid=\"51\">\n            <i class=\"ti ti-music text-3xl\" data-kid=\"52\"></i>\n        </div>\n        <div class=\"dock-item w-16 h-16 bg-white/10 rounded-[1.5rem] flex items-center justify-center text-white cursor-pointer overflow-hidden border border-white/5\" data-kid=\"53\">\n            <i class=\"ti ti-microphone text-3xl\" data-kid=\"54\"></i>\n        </div>\n        \n        \n        <div class=\"dock-item w-24 h-24 bg-[#22C55E] squircle flex items-center justify-center shadow-[0_15px_30px_rgba(34,197,94,0.5)] cursor-pointer relative -translate-y-6 border-4 border-black active:scale-90\" data-kid=\"55\">\n            <svg viewBox=\"0 0 100 100\" class=\"w-12 h-12 fill-white\" data-kid=\"56\">\n                <path d=\"M 32 32 C 15 5 50 15 50 35 L 82 52 L 32 80 Z\" data-kid=\"57\"></path>\n            </svg>\n            <div class=\"absolute -bottom-4 w-2.5 h-2.5 bg-[#22C55E] rounded-full shadow-[0_0_15px_#22C55E]\" data-kid=\"58\"></div>\n        </div>\n\n        <div class=\"dock-item w-16 h-16 bg-white/10 rounded-[1.5rem] flex items-center justify-center text-white cursor-pointer overflow-hidden border border-white/5\" data-kid=\"59\">\n            <i class=\"ti ti-heart-filled text-3xl text-red-500\" data-kid=\"60\"></i>\n        </div>\n        <div class=\"dock-item w-16 h-16 bg-white/10 rounded-[1.5rem] flex items-center justify-center text-white cursor-pointer overflow-hidden border border-white/5\" data-kid=\"61\">\n            <i class=\"ti ti-user-circle text-3xl\" data-kid=\"62\"></i>\n        </div>\n    </div>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"63\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"64\"></script>\n    <script type=\"module\" data-kid=\"65\">\n        import { animate, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n        import { animate as animeAnimate } from 'https://esm.sh/animejs@4';\n\n        gsap.registerPlugin(ScrollTrigger);\n\n        // 1. motion-spring-pop for the icon\n        animate(\"#logo-p\", \n            { scale: [0, 1], rotate: [-20, 0] }, \n            { type: \"spring\", visualDuration: 0.5, bounce: 0.65 }\n        );\n\n        // 2. gsap-mask-wipe for the headline text\n        gsap.fromTo(\".headline-char\", \n            { clipPath: \"inset(0 100% 0 0)\", y: 100, opacity: 0 }, \n            { clipPath: \"inset(0 0 0 0)\", y: 0, opacity: 1, duration: 1.2, ease: \"expo.out\", stagger: 0.05, delay: 0.1 }\n        );\n\n        // 3. anime-hover-icon-wiggle for dock items\n        document.querySelectorAll('.dock-item').forEach(icon => {\n            icon.addEventListener('mouseenter', () => {\n                animeAnimate(icon, {\n                    rotate: [0, -14, 14, -10, 10, 0],\n                    scale: 1.25,\n                    duration: 600,\n                    ease: 'outQuad'\n                });\n            });\n            icon.addEventListener('mouseleave', () => {\n                animeAnimate(icon, {\n                    scale: 1,\n                    rotate: 0,\n                    duration: 400,\n                    ease: 'spring(1, 80, 15, 0)'\n                });\n            });\n        });\n\n        // Entrance reveals for subtext and buttons\n        gsap.from(\"#hero-sub\", {\n            opacity: 0,\n            y: 30,\n            duration: 1,\n            delay: 0.8,\n            ease: \"power3.out\"\n        });\n\n        gsap.from(\"#hero-btns a\", {\n            opacity: 0,\n            y: 20,\n            duration: 0.8,\n            delay: 1,\n            stagger: 0.2,\n            ease: \"power3.out\"\n        });\n\n        // Split comparison reveals\n        gsap.from(\".brand-reveal-left\", {\n            scrollTrigger: {\n                trigger: \".brand-reveal-left\",\n                start: \"top 80%\",\n            },\n            x: -100,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"power4.out\"\n        });\n\n        gsap.from(\".brand-reveal-right\", {\n            scrollTrigger: {\n                trigger: \".brand-reveal-right\",\n                start: \"top 80%\",\n            },\n            x: 100,\n            opacity: 0,\n            duration: 1.2,\n            ease: \"power4.out\"\n        });\n\n        // Dock appearing\n        gsap.from(\"#dock-container\", {\n            y: 100,\n            opacity: 0,\n            duration: 1,\n            delay: 1.5,\n            ease: \"back.out(1.7)\"\n        });\n\n    </script>\n</section>\n",
